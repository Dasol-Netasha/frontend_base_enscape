# Copy this file to .env before deploying on NAS.
# Example: cp .env.nas.example .env

# Database
POSTGRES_DB=base_db
POSTGRES_USER=base_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# Exposed service ports on NAS
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Frontend build-time API base URL
# Keep /api if frontend and backend are served via the same frontend container.
VITE_API_BASE_URL=/api

# Timezone
TZ=Asia/Seoul
